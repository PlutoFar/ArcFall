// 轨道失稳 · 148 BPM
setcps(148/240)
const compose = ({note,s,stack,rev})=>{
 const bass=note('<[g1 ~ d2 g2 ~ g1 ab1 ~] [g1 ~ bb1 ~ a1 g1 ~ d2] [eb2 ~ eb2 bb1 ~ d2 eb2 ~] [d2 ~ ~ a1 d2 eb2 d2 fs2]>').s('sawtooth').gain(.28).lpf(1850);
 const drum=stack(s('bd ~ ~ bd ~ ~ bd ~').gain(.61),s('~ ~ sd ~').gain(.38).room(.43),s('hh ~ [hh hh] ~').fast(2).gain(.075));
 const A=note('<[g4 ~ d4 ab4 g4 ~ f4 ~] [bb4 ~ a4 g4 ~ d4 f4 ~] [eb4 ~ g4 bb4 a4 g4 ~ f4] [fs4 ~ a4 ~ g4 fs4 d4 ~]>').s('sawtooth').gain(.20).room(.52).delay(.3).delaytime(.253).lpf(5400);
 const B=note('<[g5 d5 ab5 g5 ~ d5 f5 ~] [bb5 ~ a5 g5 f5 ~ d5 ~] [eb5 g5 bb5 ~ a5 g5 f5 ~] [fs5 a5 ~ g5 fs5 ~ d5 ~]>').s('sawtooth').gain(.18).room(.56).delay(.28);
 const arp=note('g3 d4 ab4 d4 f4').s('supersaw').fast(1.6).gain(.07).juxBy(.4,rev).lpf(3100).room(.55).orbit(1);
 return{A:stack(A,bass,drum,arp),B:stack(B,bass,drum,arp),C:stack(A.slow(2),bass,drum.lpf(2000),arp),D:stack(B,bass,drum,arp,s('rim ~ cr ~').slow(2).gain(.13).orbit(2))};
};
const sections = compose({note,s,stack,rev});
arrange([8,sections.C],[8,sections.A],[8,sections.B],[8,sections.A],[8,sections.D],[8,sections.C],[8,sections.B],[8,sections.D])
