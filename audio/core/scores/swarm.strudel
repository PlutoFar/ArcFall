// 蚀巢躁动 · 172 BPM
setcps(172/240)
const compose = ({note,s,stack})=>{
 const bass=note('<[ds1 ~ ds2 e2 ds2 ~ as1 ~] [ds1 ds1 ~ fs1 ~ ds1 e1 ~] [b1 ~ b2 as2 ~ b1 a1 ~] [as1 ~ b1 as1 e2 ds2 ~ ~]>').s('sawtooth').gain(.30).lpf(2400).legato(.55);
 const drum=stack(s('bd ~ ~ [bd ~] ~ bd ~ ~').gain(.6),s('~ ~ sd ~ ~ ~ sd [~ sd]').gain(.31).room(.25),s('hh*8').gain('<.065 .09 .055 .075>').every(4,p=>p.ply(2)));
 const A=note('<[ds4 e4 ~ ds4 as3 ~ ds4 ~] [fs4 ~ e4 ds4 ~ cs4 b3 ~] [b3 ~ ds4 e4 ~ ds4 ~ as3] [as3 b3 ~ as3 e4 ~ ds4 ~]>').s('sawtooth').gain(.20).lpf(5200).lpq(.8).room(.38).delay(.2).legato(.55);
 const B=note('<[ds5 e5 ds5 ~ as4 ds5 ~ e5] [fs5 e5 ds5 cs5 b4 ~ as4 ~] [b4 ds5 e5 ~ fs5 e5 ds5 ~] [as4 b4 as4 ~ e5 ds5 ~ ~]>').s('sawtooth').gain(.19).room(.4).delay(.18);
 const chord=note('<[ds3,as3,e4] [ds3,fs3,cs4] [b2,fs3,as3] [as2,e3,gs3]>').s('supersaw').struct('x ~ x ~').gain(.09).room(.45).orbit(1);
 return{A:stack(A,bass,drum),B:stack(B,bass,drum,chord),C:stack(A.rev(),bass,drum.lpf(1900),s('rim ~ ~ rim').gain(.08)),D:stack(B,bass,drum,chord,A.fast(2).gain(.065).hpf(1500).pan(.75).orbit(2))};
};
const sections = compose({note,s,stack,rev});
arrange([8,sections.A],[8,sections.A],[8,sections.C],[8,sections.B],[8,sections.A],[8,sections.D],[8,sections.C],[8,sections.D])
