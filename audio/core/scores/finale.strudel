// 断界冲锋 · 156 BPM
setcps(156/240)
const compose = ({note,s,stack})=>{
 const bass=note('<[e1 e2 ~ e1 f1 ~ e1 ~] [e1 ~ b1 ~ e2 ~ f2 e2] [c2 c2 ~ b1 ~ c2 b1 ~] [f1 ~ f2 e2 ~ b1 e1 ~]>').s('sawtooth').gain(.32).lpf(1800).legato(.75);
 const drum=stack(s('bd ~ ~ bd ~ ~ bd ~').gain(.65),s('~ ~ ~ ~ sd ~ ~ [~ sd]').gain(.4).room(.38),s('hh*8').gain('<.07 .1 .06 .09>').orbit(1));
 const A=note('<[e4 f4 e4 ~ b3 ~ e4 ~] [g4 ~ f4 e4 ~ d4 b3 ~] [c4 ~ b3 c4 d4 ~ e4 ~] [f4 e4 ~ b3 ~ f4 e4 ~]>').s('sawtooth').gain(.24).lpf(5600).room(.5).delay(.16);
 const B=note('<[e5 ~ f5 e5 b4 ~ e5 d5] [g5 f5 e5 ~ b4 d5 ~ b4] [c5 ~ b4 g4 c5 d5 e5 ~] [f5 ~ e5 b4 e5 ~ ~ ~]>').s('sawtooth').gain(.20).room(.55).delay(.2);
 const chord=note('<[e3,b3,f4] [e3,g3,d4] [c3,g3,b3] [f3,b3,e4]>').s('supersaw').gain(.1).room(.66).legato(1.8).orbit(1);
 const metal=s('rim ~ ~ rim ~ ~ rim ~').gain(.13).room(.4).orbit(2);
 return{A:stack(A,bass,drum,chord),B:stack(B,bass,drum,chord,metal),C:stack(A.slow(2),bass,drum.lpf(2200),s('white ~').slow(4).gain(.13)),D:stack(B,bass,drum,chord,metal,s('cr ~ ~ ~').gain(.18))};
};
const sections = compose({note,s,stack,rev});
arrange([8,sections.C],[8,sections.A],[8,sections.B],[8,sections.A],[8,sections.D],[8,sections.C],[8,sections.B],[8,sections.D])
