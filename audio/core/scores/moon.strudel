// 血月突袭 · 164 BPM
setcps(164/240)
const compose = ({note,s,stack})=>{
 const bass=note('<[f1 ~ f2 c2 ~ f1 gb1 ~] [f1 f1 ~ ab1 g1 ~ f1 ~] [db2 ~ ab1 db2 ~ c2 db2 ~] [c2 ~ g1 c2 db2 c2 e2 ~]>').s('sawtooth').gain(.30).lpf(1900).legato(.63);
 const drum=stack(s('bd ~ ~ bd ~ bd ~ [~ bd]').gain(.61),s('~ ~ sd ~ ~ ~ sd ~').gain(.33).room(.32),s('hh ~ hh [~ hh]').fast(2).gain(.075).every(4,p=>p.ply(2)));
 const A=note('<[f4 ~ c5 bb4 ab4 g4 f4 ~] [ab4 ~ g4 f4 ~ eb4 c4 ~] [db4 ~ f4 ab4 g4 f4 eb4 ~] [e4 ~ g4 ~ f4 e4 c4 ~]>').s('sawtooth').gain(.21).room(.47).delay(.18).delaytime(.274).legato(.76);
 const B=note('<[f5 c6 bb5 ab5 g5 f5 ~ c5] [ab5 g5 f5 ~ eb5 c5 ~ bb4] [db5 f5 ab5 ~ g5 f5 eb5 ~] [e5 g5 f5 e5 c5 ~ f5 ~]>').s('sawtooth').gain(.18).room(.5).delay(.22);
 const chord=note('<[f3,c4,gb4] [f3,ab3,eb4] [db3,ab3,c4] [c3,g3,e4]>').s('supersaw').struct('x ~ ~ x').gain(.105).room(.6).orbit(1);
 return{A:stack(A,bass,drum,chord),B:stack(B,bass,drum,chord),C:stack(A.rev().slow(2),bass,drum.lpf(2200)),D:stack(B,bass,drum,chord,s('rim ~ ~ cr').slow(2).gain(.13).orbit(2))};
};
const sections = compose({note,s,stack,rev});
arrange([8,sections.A],[8,sections.A],[8,sections.B],[8,sections.C],[8,sections.D],[8,sections.A],[8,sections.B],[8,sections.D])
