// 弧光压境 · 144 BPM
setcps(144/240)
const compose = ({note,s,stack,rev})=>{
 const bass=note('<[d2 d2 ~ d3 ~ d2 eb2 ~] [d2 ~ d2 a1 d2 ~ c2 db2] [bb1 bb1 ~ bb2 ~ bb1 a1 ~] [a1 ~ a2 ~ bb1 a1 ~ cs2]>').s('sawtooth').gain(.30).lpf(1650).legato(.68);
 const drums=stack(s('bd ~ ~ bd ~ ~ bd ~').gain(.6),s('~ ~ sd ~ ~ ~ sd [~ sd]').gain(.32).room(.32),s('hh ~ hh hh ~ hh ~ hh').gain(.09));
 const A=note('<[d4 ~ eb4 d4 a3 ~ c4 ~] [d4 ~ a4 ~ g4 f4 eb4 ~] [f4 ~ eb4 d4 ~ bb3 ~ a3] [cs4 ~ e4 ~ d4 cs4 a3 ~]>').s('sawtooth').gain(.22).lpf(5800).room(.48).delay(.18).delaytime(.3125).legato(.82);
 const B=note('<[d5 ~ a4 d5 eb5 d5 ~ a4] [c5 ~ bb4 a4 ~ g4 f4 e4] [f5 eb5 d5 ~ bb4 ~ a4 g4] [cs5 ~ d5 e5 ~ cs5 a4 ~]>').s('sawtooth').gain(.20).room(.52).delay(.22).delaytime(.3125);
 const chord=note('<[d3,a3,eb4] [d3,a3,c4] [bb2,f3,a3] [a2,e3,cs4]>').s('supersaw').gain(.11).legato(1.6).room(.64).orbit(1);
 const pulse=note('d4 a3 eb4 a3').s('supersaw').fast(2).gain(.065).juxBy(.3,rev).lpf(2800).delay(.24).orbit(2);
 const impact=s('cr ~ ~ ~').slow(2).gain(.20).room(.4);
 return{A:stack(A,bass,drums,chord),B:stack(B,bass,drums,chord,pulse),C:stack(A.slow(2),bass,drums.lpf(3200),impact),D:stack(B,bass,drums,chord,pulse,impact)};
};
const sections = compose({note,s,stack,rev});
arrange([8,sections.C],[8,sections.A],[8,sections.A],[8,sections.B],[8,sections.C],[8,sections.D],[8,sections.B],[8,sections.D])
