// 铁誓推进 · 132 BPM
setcps(132/240)
const compose = ({note,s,stack})=>{
 const bass=note('<[c2 ~ c2 g1 c2 ~ ~ bb1] [c2 c2 ~ ~ eb2 d2 c2 ~] [ab1 ~ ab1 eb2 ~ ab1 g1 ~] [g1 g1 ~ bb1 ~ g1 b1 ~]>').s('sawtooth').gain(.3).lpf(1200);
 const drum=stack(s('bd ~ ~ ~ bd ~ [bd ~] ~').gain(.64),s('~ sd ~ sd').gain(.30).room(.36),s('rim ~ ~ ~ ~ ~ rim ~').gain(.11).room(.5),s('hh ~ hh ~').gain(.07));
 const A=note('<[c4 ~ g3 ~ c4 d4 eb4 ~] [d4 ~ c4 ~ bb3 g3 ~ ~] [ab3 ~ c4 ~ eb4 d4 c4 ~] [b3 ~ g3 ~ d4 b3 c4 ~]>').s('sawtooth').gain(.23).lpf(4200).room(.46).legato(1.15);
 const B=note('<[c4 c5 ~ g4 ~ eb4 d4 c4] [g4 ~ bb4 ab4 g4 ~ d4 ~] [ab4 ~ eb4 c4 eb4 ~ g4 ~] [b4 ~ g4 d4 ~ b3 c4 ~]>').s('sawtooth').gain(.22).room(.48).delay(.12);
 const chord=note('<[c3,g3] [c3,eb3,bb3] [ab2,eb3] [g2,d3,b3]>').s('supersaw').gain(.12).room(.6).legato(1.9).orbit(1);
 return{A:stack(A,bass,drum,chord),B:stack(B,bass,drum,chord),C:stack(A.slow(2),bass,drum.lpf(2300)),D:stack(B,bass,drum,chord,s('cr ~ ~ rim').slow(2).gain(.15).orbit(2))};
};
const sections = compose({note,s,stack,rev});
arrange([8,sections.C],[8,sections.A],[8,sections.B],[8,sections.A],[8,sections.C],[8,sections.D],[8,sections.B],[8,sections.D])
