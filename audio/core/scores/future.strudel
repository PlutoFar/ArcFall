// 磁轨过载 · 150 BPM
setcps(150/240)
const compose = ({note,s,stack,rev})=>{
 const bass=note('<[fs1 ~ fs2 ~ ~ fs1 g1 fs1] [fs1 fs2 ~ cs2 ~ e2 ~ fs2] [d2 ~ d2 ~ cs2 d2 ~ a1] [cs2 ~ ~ cs3 d3 cs3 b2 ~]>').s('sawtooth').gain(.29).lpf(2400).legato(.6);
 const drum=stack(s('bd ~ [~ bd] ~ bd ~ ~ bd').gain(.60),s('~ ~ sd ~ ~ ~ sd ~').gain(.33).room(.26),s('hh [~ hh] ~ hh').fast(2).gain(.085));
 const A=note('<[fs4 ~ cs4 fs4 ~ g4 fs4 ~] [a4 ~ fs4 e4 ~ cs4 ~ b3] [d4 ~ a4 ~ g4 fs4 e4 ~] [cs4 ~ gs4 g4 fs4 ~ cs4 ~]>').s('sawtooth').gain(.21).lpf(6400).room(.4).delay(.28).delaytime(.15).legato(.6);
 const B=note('<[fs5 cs5 fs5 ~ g5 fs5 ~ e5] [a5 ~ fs5 e5 cs5 ~ b4 cs5] [d5 a4 d5 e5 ~ fs5 e5 d5] [cs5 ~ gs5 g5 fs5 ~ e5 cs5]>').s('sawtooth').gain(.19).room(.42).delay(.25).delaytime(.15);
 const chord=note('<[fs3,cs4,g4] [fs3,a3,e4] [d3,a3,cs4] [cs3,gs3,b3]>').s('supersaw').struct('x ~ ~ x').gain(.12).room(.52).orbit(1);
 const glitch=note('fs4 g4 cs4 ~').s('supersaw').fast(2).juxBy(.45,rev).gain(.055).hpf(800).delay(.3).orbit(2);
 return{A:stack(A,bass,drum,chord),B:stack(B,bass,drum,chord,glitch),C:stack(A.rev(),bass,drum.lpf(2200)),D:stack(B,bass,drum,chord,glitch,s('cr ~ ~ ~').slow(2).gain(.16))};
};
const sections = compose({note,s,stack,rev});
arrange([8,sections.A],[8,sections.C],[8,sections.A],[8,sections.B],[8,sections.D],[8,sections.C],[8,sections.B],[8,sections.D])
