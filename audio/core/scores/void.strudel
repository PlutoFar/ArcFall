// 裂隙脉冲 · 146 BPM
setcps(146/240)
const compose = ({note,s,stack,rev})=>{
 const bass=note('<[cs1 cs2 ~ d2 ~ cs1 gs1 ~] [cs1 ~ ~ cs2 g1 ~ cs1 ~] [a1 ~ a2 gs2 ~ a1 g1 ~] [gs1 ~ a1 gs1 d2 cs2 ~ ~]>').s('sawtooth').gain(.30).lpf('<800 1500 1100 2200>').lpq(1.2).legato(.9);
 const drum=stack(s('bd ~ ~ ~ ~ bd [~ bd] ~').gain(.65),s('~ ~ sd ~').gain(.4).room(.48),s('hh ~ ~ hh').fast(2).gain(.085));
 const A=note('<[cs4 ~ d4 cs4 ~ g3 ~ gs3] [cs4 ~ e4 d4 cs4 ~ b3 ~] [a3 ~ cs4 ~ d4 cs4 b3 ~] [gs3 ~ d4 cs4 ~ gs3 g3 ~]>').s('sawtooth').gain(.23).lpf('<2100 4200 2700 3600>').lpq(1.5).room(.6).delay(.28).legato(.65);
 const B=note('<[cs5 ~ d5 cs5 g4 ~ gs4 ~] [e5 d5 cs5 ~ b4 gs4 ~ g4] [a4 cs5 d5 ~ e5 d5 cs5 ~] [gs4 d5 cs5 ~ gs4 g4 cs5 ~]>').s('sawtooth').gain(.20).room(.62).delay(.31).lpf(4600);
 const chord=note('<[cs3,gs3,d4] [cs3,g3,b3] [a2,e3,gs3] [gs2,d3,fs3]>').s('supersaw').gain(.10).room(.72).legato(2).orbit(1);
 return{A:stack(A,bass,drum,chord),B:stack(B,bass,drum,chord),C:stack(A.slow(2),bass,drum.lpf(1800),s('white ~').slow(4).gain(.12)),D:stack(B,bass,drum,chord,A.juxBy(.35,rev).gain(.055).hpf(1300).orbit(2))};
};
const sections = compose({note,s,stack,rev});
arrange([8,sections.C],[8,sections.A],[8,sections.B],[8,sections.C],[8,sections.A],[8,sections.D],[8,sections.B],[8,sections.D])
