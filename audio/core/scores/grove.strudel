// 荆棘围城 · 136 BPM
setcps(136/240)
const compose = ({note,s,stack})=>{
 const bass=note('<[b1 ~ b2 fs2 ~ b1 c2 ~] [b1 b1 ~ d2 cs2 ~ b1 ~] [g1 ~ g2 d2 ~ g1 fs1 ~] [fs1 ~ cs2 fs2 g2 fs2 ~ as1]>').s('sawtooth').gain(.30).lpf(1350);
 const drum=stack(s('bd ~ bd ~ ~ bd ~ ~').gain(.60),s('~ sd ~ sd').gain(.29).room(.38),s('rim ~ ~ [~ rim]').gain(.07).room(.55),s('hh ~ hh ~').gain(.07));
 const A=note('<[b3 ~ e4 ds4 d4 ~ b3 ~] [fs4 ~ e4 d4 cs4 ~ b3 ~] [g4 ~ fs4 e4 ~ d4 b3 ~] [as3 ~ cs4 e4 ~ cs4 b3 ~]>').s('sawtooth').gain(.23).lpf(4600).room(.5).delay(.18).legato(.85);
 const B=note('<[b4 e5 ds5 d5 ~ b4 fs4 ~] [fs5 e5 d5 cs5 b4 ~ a4 ~] [g5 ~ fs5 e5 d5 ~ b4 ~] [as4 cs5 e5 cs5 ~ b4 ~ ~]>').s('sawtooth').gain(.20).room(.52).delay(.2);
 const chord=note('<[b2,fs3,c4] [b2,d3,a3] [g2,d3,fs3] [fs2,cs3,as3]>').s('supersaw').gain(.12).room(.64).legato(1.8).orbit(1);
 return{A:stack(A,bass,drum,chord),B:stack(B,bass,drum,chord),C:stack(A.slow(2),bass,drum.lpf(2300)),D:stack(B,bass,drum,chord,s('cr ~ rim ~').slow(2).gain(.14).orbit(2))};
};
const sections = compose({note,s,stack,rev});
arrange([8,sections.A],[8,sections.C],[8,sections.A],[8,sections.B],[8,sections.D],[8,sections.A],[8,sections.C],[8,sections.D])
